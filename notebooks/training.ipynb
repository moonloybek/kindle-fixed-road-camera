# Training - Fine-tuning for Accident Classification

## Dataset Preparation
```python
# Prepare clips for accident classification
import os
import shutil
from pathlib import Path

clips_dir = Path('/path/to/dota_clips')
output_dir = Path('../data/accident_clips')

# Structure:
# data/accident_clips/
#   ├── train/
#   │   ├── accident/
#   │   └── normal/
#   ├── val/
#   │   ├── accident/
#   │   └── normal/
#   └── test/

for split in ['train', 'val', 'test']:
    (output_dir / split / 'accident').mkdir(parents=True, exist_ok=True)
    (output_dir / split / 'normal').mkdir(parents=True, exist_ok=True)
```

## Model Definition
```python
import torch
import torch.nn as nn
from ultralytics import YOLO

class AccidentClassifier(nn.Module):
    def __init__(self):
        super().__init__()
        self.backbone = YOLO('yolov8n.pt')
        self.fc = nn.Linear(1280, 2)  # Binary classification

    def forward(self, x):
        features = self.backbone(x, verbose=False)
        return self.fc(features[-1].flatten(1))
```

## Training Loop
```python
from torch.utils.data import DataLoader

model = AccidentClassifier().cuda()
criterion = nn.CrossEntropyLoss()
optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)

for epoch in range(10):
    for frames, labels in train_loader:
        optimizer.zero_grad()
        outputs = model(frames.cuda())
        loss = criterion(outputs, labels.cuda())
        loss.backward()
        optimizer.step()

    # Validation
    val_acc = evaluate(model, val_loader)
    print(f"Epoch {epoch}: Val Acc = {val_acc:.3f}")

torch.save(model.state_dict(), '../weights/accident_classifier.pt')
```