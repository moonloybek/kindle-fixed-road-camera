# EDA - Traffic Video Analysis

## Video Metadata
```python
import cv2
import pandas as pd
from pathlib import Path

sample_dir = Path('../sample')
videos = list(sample_dir.glob('*.MP4'))

metadata = []
for video in videos:
    cap = cv2.VideoCapture(str(video))
    fps = cap.get(cv2.CAP_PROP_FPS)
    n_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    duration = n_frames / fps if fps > 0 else 0
    cap.release()

    metadata.append({
        'video': video.name,
        'fps': fps,
        'width': width,
        'height': height,
        'frames': n_frames,
        'duration_s': round(duration, 2)
    })

df = pd.DataFrame(metadata)
print(df)
df.to_csv('../data/video_inventory.csv', index=False)
```

## Object Detection Statistics
```python
# Load detection results
detections = pd.read_csv('../outputs/eda/detections.csv')

# Class distribution
class_counts = detections['class_name'].value_counts()
print("Detections by class:")
print(class_counts)

# Vehicle size distribution
vehicle_sizes = detections[detections['class_name'].isin(['car', 'truck', 'bus'])]['area']
print(f"\nVehicle size stats: min={vehicle_sizes.min()}, max={vehicle_sizes.max()}, mean={vehicle_sizes.mean():.0f}")
```

## Traffic Density Over Time
```python
import matplotlib.pyplot as plt

# Count vehicles per frame
density = detections.groupby('video').size()
plt.figure(figsize=(12, 4))
for video in detections['video'].unique():
    video_det = detections[detections['video'] == video]
    density_by_time = video_det.groupby('t_sec').size()
    plt.plot(density_by_time.index, density_by_time.values, label=video)
plt.xlabel('Time (s)')
plt.ylabel('Detections')
plt.title('Traffic Density Over Time')
plt.legend()
plt.tight_layout()
plt.savefig('../outputs/eda/traffic_density_over_time.png')
plt.show()
```