# WIUT Hackathon 2026 - Event Detection Analysis

## Setup
```python
import json
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

# Load predictions
with open('../predictions_samples.json') as f:
    predictions = json.load(f)

# Load ground truth
with open('../my_labels.json') as f:
    ground_truth = json.load(f)
```

## Event Distribution
```python
# Count events by class
event_counts = {}
for video, data in predictions['videos'].items():
    for start, end, label in data['events']:
        event_counts[label] = event_counts.get(label, 0) + 1

plt.bar(event_counts.keys(), event_counts.values())
plt.xticks(rotation=45)
plt.title('Detected Events by Class')
plt.tight_layout()
plt.show()
```

## Runtime Analysis
```python
# Parse runtime logs
runtimes = []
for video, log in predictions.get('log', {}).items():
    runtimes.append({
        'video': video,
        'part_a': log.get('part_a_sec', 0),
        'total': log.get('total_sec', 0),
        'duration': log.get('duration', 0)
    })

runtime_df = pd.DataFrame(runtimes)
runtime_df['budget_usage'] = runtime_df['total'] / (runtime_df['duration'] * 3) * 100
print(runtime_df)
```